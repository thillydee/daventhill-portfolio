---
import BaseLayout from '../layouts/BaseLayout.astro';

const breadcrumbs = [
  { name: 'Startseite', path: '/de/' },
  { name: 'Webdesign', path: '/webdesign' },
];

const packages = [
  {
    name: 'Sichtbar',
    price: '1’200',
    priceSchema: '1200',
    duration: 'ca. 2 Wochen',
    intro:
      'Kein Neubau — Ihre bestehende Seite wird endlich sichtbar. Für viele Betriebe ist das der grössere Hebel als eine neue Website, und der schnellste Weg zu mehr Anfragen.',
    items: [
      'Google-Unternehmensprofil aufsetzen und optimieren',
      'Adresse, Öffnungszeiten und Kontaktdaten überall konsistent (NAP)',
      'Structured Data / LocalBusiness-Schema, damit Google Sie versteht',
      'Heading-Struktur und URLs Ihrer bestehenden Seite korrigiert',
      'Impressum und Datenschutzerklärung (revDSG-konform)',
    ],
  },
  {
    name: 'Neuer Auftritt',
    price: 'ab CHF 2’800',
    priceSchema: '2800',
    duration: 'ca. 4 bis 6 Wochen',
    intro:
      'Ein kompletter Neubau, auf Astro — dem gleichen technischen Fundament, mit dem ich auch diese Seite gebaut habe: schnell, sauber strukturiert, für Google lesbar.',
    items: [
      'Fünf bis sieben Seiten, für Ihren Betrieb gebaut — nicht aus einem Baukasten mit hundert anderen Websites',
      'Alles aus Paket 1 inklusive',
      'Buchungs- oder Kontakt-Möglichkeit an mehreren Stellen der Seite, nicht nur oben',
      'Bildoptimierung, Ladezeit und mobile Darstellung',
      'Basis-SEO und eine saubere Seitenstruktur',
    ],
  },
  {
    name: 'Komplett',
    price: 'ab CHF 4’200',
    priceSchema: '4200',
    duration: 'wie Paket 2, plus Zeit für Texte und Bildkonzept',
    intro:
      'Alles aus Paket 2, plus was einen Betrieb mit Laufkundschaft oder Termingeschäft wirklich weiterbringt:',
    items: [
      'Zweisprachig Deutsch/Englisch',
      'Texte von Grund auf für Ihren Betrieb geschrieben, nicht generisch',
      'Bildkonzept: Ich koordiniere ein Shooting oder bereite Ihr bestehendes Bildmaterial auf',
      'Eine einfache Möglichkeit, Google-Bewertungen zu sammeln — zum Beispiel eine QR-Karte am Empfang, die direkt zur Bewertung führt',
      'Drei Monate Betreuung nach dem Livegang inklusive',
    ],
  },
];

const ablaufSteps = [
  {
    title: 'Erstgespräch',
    text: '30 Minuten, unverbindlich, per Video-Call oder vor Ort in Basel. Wir klären, was Sie brauchen und welches Paket passt.',
  },
  {
    title: 'Angebot',
    text: 'Sie erhalten innerhalb weniger Tage ein klares Angebot mit Fixpreis oder Preisrahmen, je nach Paket.',
  },
  {
    title: 'Umsetzung',
    text: 'Konzept, Texte, Design und Aufbau. Je nach Paket zwei bis sechs Wochen; Sie sehen den Fortschritt laufend, nicht erst am Schluss.',
  },
  {
    title: 'Review',
    text: 'Sie prüfen die fertige Seite, wir passen an, was noch nicht stimmt.',
  },
  {
    title: 'Livegang',
    text: 'Die Seite geht online. Mit Betreuungsabo übernehme ich Hosting, Updates und kleine Änderungen direkt weiter.',
  },
];

const faqs = [
  {
    question: 'Kann ich selbst Inhalte ändern?',
    answer:
      'Nach dem Livegang können Sie mir kleine Änderungen jederzeit schicken — neuer Preis, neue Öffnungszeiten, neues Bild — und ich setze sie um, meist noch am nächsten Tag. Das ist Teil der Betreuung (CHF 45/Monat oder CHF 480/Jahr). Wenn Sie grössere Inhalte lieber selbst pflegen möchten, besprechen wir das im Erstgespräch.',
  },
  {
    question: 'Was kostet der Betrieb?',
    answer:
      'Die Betreuung kostet CHF 45 im Monat oder CHF 480 im Jahr und deckt Hosting, Domain, Updates, Backups und kleine Inhaltsänderungen ab. Ohne Betreuungsabo übernehmen Sie Hosting und Domain selbst — dazu berate ich Sie gerne, wenn Sie das bevorzugen.',
  },
  {
    question: 'Wie lange dauert es?',
    answer:
      'Bei Paket 1 ("Sichtbar") rund zwei Wochen. Bei einem Neubau (Paket 2 oder 3) rechnen Sie mit vier bis sechs Wochen, je nach Umfang und wie schnell Inhalte und Feedback von Ihrer Seite kommen.',
  },
  {
    question: 'Was, wenn ich schon eine Wix-Seite habe?',
    answer:
      'Kein Problem — Paket 1 ("Sichtbar") baut nichts neu, sondern macht Ihre bestehende Seite, egal ob Wix, Squarespace oder etwas anderes, für Google sichtbar und behebt die häufigsten technischen Lücken. Ein Neubau lohnt sich erst, wenn die bestehende Seite selbst das Problem ist — das sage ich Ihnen ehrlich im Erstgespräch.',
  },
];

const service = {
  name: 'Webdesign für KMU',
  description:
    'Websites für lokale Betriebe in Basel und Umgebung: Google-Unternehmensprofil, Neubau oder kompletter zweisprachiger Auftritt, mit klaren Paketen und transparenten Preisen.',
  areaServed: 'Nordwestschweiz',
  offers: packages.map((pkg) => ({ name: pkg.name, price: pkg.priceSchema })),
};
---

<BaseLayout
  title="Webdesign für KMU in Basel"
  description="Websites für lokale Betriebe in Basel: klare Pakete, transparente Preise, gebaut von einem Product Owner."
  path="/webdesign"
  ogImageSlug="webdesign"
  locale="de"
  breadcrumbs={breadcrumbs}
  faq={faqs}
  service={service}
>
  <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-24">
    <h1 class="max-w-3xl text-4xl font-bold tracking-tight text-ink sm:text-5xl">
      Eine Website ist ein Produkt. Kein Bild.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">
      Ich bin Product Owner in Basel und baue hauptberuflich digitale Produkte, die Kunden
      tatsächlich nutzen. Nebenbei baue ich Websites für lokale Betriebe in Basel und
      Umgebung — nach den gleichen Prinzipien: schnell, mobil, auffindbar, und so gebaut, dass
      jemand darauf tatsächlich anruft oder bucht.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a
        href="#kontakt"
        class="inline-flex items-center justify-center rounded-md bg-brand px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-dark"
      >
        Unverbindlich anfragen
      </a>
      <a
        href="#pakete"
        class="inline-flex items-center justify-center rounded-md border border-border px-5 py-3 text-sm font-semibold text-ink transition-colors hover:border-brand hover:text-brand"
      >
        Pakete ansehen
      </a>
    </div>
  </section>

  <section id="warum" class="scroll-mt-24 border-t border-border bg-surface-alt">
    <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
      <h2 class="text-2xl font-bold text-ink sm:text-3xl">Warum die meisten KMU-Websites keine Anfragen bringen</h2>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-ink-soft">
        Die meisten Websites von lokalen Betrieben bringen keine Anfragen — nicht weil der
        Betrieb schlecht ist, sondern weil die Website die eigentliche Arbeit nicht macht. Wenn
        eine Seite auf dem Handy langsam lädt oder sich nicht sauber bedienen lässt, ist der
        Besuch in Sekunden wieder weg, bevor er überhaupt gelesen hat, was Sie anbieten. Und
        wenn Google Ihren Betrieb bei einer lokalen Suche gar nicht zuverlässig anzeigt, spielt
        die Website ihre Rolle nie — sie wird schlicht nicht gefunden.
      </p>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-ink-soft">
        Ehrlich gesagt: Für viele lokale Betriebe ist nicht die Website der grösste Hebel,
        sondern das Google-Unternehmensprofil. Beide greifen aber ineinander — eine gute Website
        ohne korrektes Google-Profil wird nicht gefunden, ein gutes Google-Profil ohne brauchbare
        Website verliert die Anfrage, sobald jemand draufklickt. Ich sage Ihnen offen, wo bei
        Ihnen tatsächlich der grössere Hebel liegt, statt Ihnen alles zu verkaufen, was ich
        anbiete.
      </p>
    </div>
  </section>

  <section id="pakete" class="scroll-mt-24 mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-wide text-brand">Leistungspakete</p>
    <h2 class="mt-2 text-2xl font-bold text-ink sm:text-3xl">Drei Stufen, klare Preise. Kein Angebot nach Bauchgefühl.</h2>

    <div class="mt-8 grid gap-6 sm:grid-cols-3">
      {packages.map((pkg) => (
        <div class="rounded-xl border border-border bg-surface p-6">
          <h3 class="text-lg font-semibold text-ink">{pkg.name}</h3>
          <p class="mt-1 text-2xl font-bold text-ink">{pkg.price}</p>
          <p class="mt-3 text-sm leading-relaxed text-ink-soft">{pkg.intro}</p>
          <ul class="mt-4 space-y-2">
            {pkg.items.map((item) => (
              <li class="flex gap-3 text-sm text-ink-soft">
                <span class="mt-1.5 h-1.5 w-1.5 flex-none rounded-full bg-brand"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <p class="mt-4 text-xs font-semibold uppercase tracking-wide text-muted">Dauer: {pkg.duration}</p>
        </div>
      ))}
    </div>

    <div class="mt-6 rounded-xl border border-border bg-surface-alt p-6">
      <h3 class="text-lg font-semibold text-ink">Betreuung · CHF 45/Monat oder CHF 480/Jahr</h3>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-ink-soft">
        Hosting, Domain, Updates, Backups und kleine Inhaltsänderungen: Sie schicken mir den
        neuen Preis oder die neuen Öffnungszeiten, am nächsten Tag steht's auf der Seite. Sie
        müssen nichts selbst einrichten oder technisch verstehen — genau dafür gibt es die
        Betreuung.
      </p>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        <div class="rounded-lg border border-border bg-surface p-4 text-sm text-ink-soft">CHF 45 / Monat</div>
        <div class="rounded-lg border border-border bg-surface p-4 text-sm text-ink-soft">CHF 480 / Jahr</div>
      </div>
    </div>

    <p class="mt-6 max-w-3xl text-sm leading-relaxed text-muted">
      <strong class="text-ink-soft">Grössere Projekte:</strong> Für einen Umfang wie
      ava-beauty.ch — zweisprachig, mehrere Leistungs-Unterseiten, Portfolio, eigene
      Bildvorschau pro Seite für Social Media — rechnen Sie mit CHF 6’500 bis 9’000. Kein
      Standardpaket, sondern eine Offerte nach einem Erstgespräch.
    </p>

    <ul class="mt-4 space-y-1 text-sm text-muted">
      <li>Zweite Sprache: +25–30 % des Grundpakets</li>
      <li>Texte von Grund auf, pro Seite: CHF 250–400</li>
      <li>Google-Unternehmensprofil separat, ohne Website-Paket: CHF 400</li>
    </ul>
  </section>

  <section id="referenz" class="scroll-mt-24 border-t border-border bg-surface-alt">
    <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-wide text-brand">Referenzprojekt</p>
      <h2 class="mt-2 text-2xl font-bold text-ink sm:text-3xl">ava-beauty.ch — Website für Sandra, Hair &amp; Make-up Artist in Basel</h2>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-ink-soft">
        Zweisprachig Deutsch/Englisch, gebaut auf Astro, mit fünf eigenen Leistungsseiten,
        Portfolio, Über-mich- und Kontaktseite. Jede Seite hat eine eigene Bildvorschau für
        Social Media, alle Bilder sind für schnelles Laden optimiert, und die Texte sind in
        beiden Sprachen auf Sandras Betrieb zugeschnitten — nicht übersetzt, sondern für jede
        Sprache neu formuliert.
      </p>
      <a
        href="https://ava-beauty.ch"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-flex items-center justify-center rounded-md border border-border px-5 py-3 text-sm font-semibold text-ink transition-colors hover:border-brand hover:text-brand"
      >
        ava-beauty.ch ansehen →
      </a>
    </div>
  </section>

  <section id="ablauf" class="scroll-mt-24 mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-wide text-brand">Ablauf</p>
    <h2 class="mt-2 text-2xl font-bold text-ink sm:text-3xl">Von Erstgespräch bis Livegang</h2>
    <ol class="mt-8 space-y-6">
      {ablaufSteps.map((step, index) => (
        <li class="flex gap-4">
          <span class="flex h-8 w-8 flex-none items-center justify-center rounded-full bg-brand text-sm font-semibold text-white">
            {index + 1}
          </span>
          <div>
            <h3 class="text-base font-semibold text-ink">{step.title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-ink-soft">{step.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section id="faq" class="scroll-mt-24 border-t border-border bg-surface-alt">
    <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-wide text-brand">FAQ</p>
      <h2 class="mt-2 text-2xl font-bold text-ink sm:text-3xl">Häufige Fragen</h2>
      <dl class="mt-8 space-y-6">
        {faqs.map((item) => (
          <div>
            <dt class="text-base font-semibold text-ink">{item.question}</dt>
            <dd class="mt-2 max-w-3xl text-sm leading-relaxed text-ink-soft">{item.answer}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section id="kontakt" class="scroll-mt-24 mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-wide text-brand">Kontakt</p>
    <h2 class="mt-2 text-2xl font-bold text-ink sm:text-3xl">Erzählen Sie mir von Ihrem Betrieb</h2>
    <p class="mt-4 max-w-2xl text-base text-muted">
      Erzählen Sie mir kurz von Ihrem Betrieb — ich melde mich innerhalb von 1–2 Werktagen mit
      einer ehrlichen Einschätzung, was bei Ihnen den grössten Unterschied machen würde.
    </p>

    <form id="webdesign-contact-form" class="mt-8 max-w-xl" novalidate>
      <div class="grid gap-5">
        <div>
          <label for="wd-name" class="text-sm font-semibold text-ink">Name</label>
          <input
            type="text"
            id="wd-name"
            name="name"
            required
            class="mt-1.5 w-full rounded-md border border-border bg-surface px-3.5 py-2.5 text-sm text-ink placeholder:text-muted focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand"
          />
        </div>
        <div>
          <label for="wd-email" class="text-sm font-semibold text-ink">E-Mail</label>
          <input
            type="email"
            id="wd-email"
            name="email"
            required
            class="mt-1.5 w-full rounded-md border border-border bg-surface px-3.5 py-2.5 text-sm text-ink placeholder:text-muted focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand"
          />
        </div>
        <div>
          <label for="wd-company" class="text-sm font-semibold text-ink">
            Art des Betriebs <span class="font-normal text-muted">optional</span>
          </label>
          <input
            type="text"
            id="wd-company"
            name="company"
            placeholder="z. B. Coiffeur, Handwerksbetrieb, Praxis"
            class="mt-1.5 w-full rounded-md border border-border bg-surface px-3.5 py-2.5 text-sm text-ink placeholder:text-muted focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand"
          />
        </div>
        <div>
          <label for="wd-message" class="text-sm font-semibold text-ink">Nachricht</label>
          <textarea
            id="wd-message"
            name="message"
            rows="5"
            required
            class="mt-1.5 w-full rounded-md border border-border bg-surface px-3.5 py-2.5 text-sm text-ink placeholder:text-muted focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand"
          ></textarea>
        </div>
        <input type="hidden" name="source" value="webdesign" />
        <div class="hidden" aria-hidden="true">
          <label for="wd-website">Website</label>
          <input type="text" id="wd-website" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <button
          type="submit"
          class="inline-flex w-fit items-center justify-center rounded-md bg-brand px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-dark disabled:cursor-not-allowed disabled:opacity-60"
        >
          Anfrage senden
        </button>
        <p
          id="wd-form-status"
          class="text-sm"
          role="status"
          aria-live="polite"
          data-sending="Wird gesendet..."
          data-success="Danke! Ich melde mich innerhalb von 1–2 Werktagen."
          data-error="Da ist etwas schiefgelaufen. Schreiben Sie mir direkt an daventhill@gmail.com."
        ></p>
      </div>
    </form>
  </section>
</BaseLayout>

<script>
  import { track } from '@vercel/analytics';

  const form = document.getElementById('webdesign-contact-form') as HTMLFormElement;
  const status = document.getElementById('wd-form-status') as HTMLParagraphElement;
  const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement;

  form.addEventListener('submit', async (event) => {
    event.preventDefault();

    submitButton.disabled = true;
    status.textContent = status.dataset.sending ?? '';
    status.className = 'text-sm text-muted';

    const formData = new FormData(form);
    const payload = Object.fromEntries(formData.entries());

    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (!response.ok) {
        throw new Error('Request failed');
      }

      form.reset();
      status.textContent = status.dataset.success ?? '';
      status.className = 'text-sm text-green-700';
      track('webdesign_contact_form_submit');
    } catch (error) {
      status.textContent = status.dataset.error ?? '';
      status.className = 'text-sm text-red-700';
    } finally {
      submitButton.disabled = false;
    }
  });
</script>
